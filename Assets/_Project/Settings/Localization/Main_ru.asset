    m_Metadata:
      m_Items: []
  - m_Id: 3648978661924864
    m_Localized: "\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415: \u0412\u0435\u0440\u0441\u0438\u044F
      1.0.5 (\u041F\u043E\u0441\u0442-\u0414\u0436\u0435\u043C).\r\n\u0415\u0441\u043B\u0438
      \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u0430 Jam \u0432\u0435\u0440\u0441\u0438\u044F,
      \u0441\u043A\u0430\u0447\u0430\u0439\u0442\u0435 \u0435\u0451 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
